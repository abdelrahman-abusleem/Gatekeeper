<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GatekeeperPackageVersion Condition="'$(GatekeeperPackageVersion)' == ''">0.1.0-preview.1</GatekeeperPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Gatekeeper.Infrastructure" Version="$(GatekeeperPackageVersion)" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
